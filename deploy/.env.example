# Copy to deploy/.env ON THE SERVER. Never commit the real file.

# Public URL of the app (web + API on the same origin)
PUBLIC_URL=https://soon.64.176.175.97.nip.io
# Host port the web container binds to (127.0.0.1 only)
WEB_PORT=8093

# openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# DEV/TRIAL ONLY: any email code signs in. Turn off before real launch.
AUTH_ACCEPT_ANY_OTP=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Comma-separated admin emails (never covered by AUTH_ACCEPT_ANY_OTP)
ADMIN_EMAILS=

# Object storage (Vultr, S3-compatible)
S3_ENDPOINT=https://ams1.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET=soon-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=https://ams1.vultrobjects.com/soon-media
STORAGE_PREFIX=prod
