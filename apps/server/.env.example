# Copy to .env and fill in. Never commit .env — the repo is public.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Matches docker-compose.yml for local dev
DATABASE_URL=postgres://soon:soon_dev_password@localhost:5432/soon

# Public URL of this server (used by Better Auth for callbacks)
BETTER_AUTH_URL=http://localhost:4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Comma-separated web origins allowed to call the API (Expo web dev server, prod web app)
WEB_ORIGINS=http://localhost:8081

# Optional in dev — the social buttons are hidden until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# Enables the profile's "reset demo data" tool (demo accounts only).
DEMO_TOOLS=true

# Comma-separated admin emails.
ADMIN_EMAILS=

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
STORAGE_PREFIX=dev
