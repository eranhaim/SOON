{
  "name": "@soon/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.22",
    "@better-auth/expo": "^1.7.22",
    "@fastify/cors": "^11.4.1",
    "@soon/shared": "*",
    "better-auth": "^1.7.22",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
