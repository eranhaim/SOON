# Copy to .env. EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
#
# Web / iOS simulator: http://localhost:4000
# Android emulator:   http://10.0.2.2:4000
# Physical phone:     http://<your-PC-LAN-IP>:4000  (e.g. http://192.168.1.20:4000)
EXPO_PUBLIC_API_URL=http://localhost:4000
